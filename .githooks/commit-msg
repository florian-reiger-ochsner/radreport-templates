#!/bin/sh
# Entfernt Claude Co-Author-/Session-Trailer aus JEDER Commit-Message,
# unabhaengig davon, welches Werkzeug den Commit erzeugt. Verhindert, dass
# der GitHub-"claude"-Contributor-Eintrag erneut auftaucht.
sed -i.bak -E '/^Co-Authored-By: [Cc]laude/d; /^Claude-Session:/d' "$1"
rm -f "$1.bak"
